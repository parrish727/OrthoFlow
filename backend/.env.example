# OrthoFlow Backend — Environment Configuration
# Copy to .env and fill in actual values. NEVER commit real secrets.

# Database
DATABASE_URL=postgresql://orthoflow:changeme@localhost:5433/orthoflow

# Redis
REDIS_URL=redis://localhost:6380/0

# Auth
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256

# Anthropic (LLM — Claude only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Object Storage (MinIO)
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here
S3_BUCKET=invoices

# Stedi Clearinghouse
STEDI_API_KEY=your_stedi_api_key_here
STEDI_BASE_URL=https://healthcare.stedi.com/2024-04-01
STEDI_WEBHOOK_SECRET=your_webhook_secret_here

# Twilio (SMS MFA)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=+15551234567

# QuickBooks
QBO_CLIENT_ID=your_qbo_client_id_here
QBO_CLIENT_SECRET=your_qbo_client_secret_here
QBO_REDIRECT_URI=https://api.orthoflowsolutions.com/api/v1/integrations/quickbooks/callback
QBO_ENVIRONMENT=sandbox

# HIPAA
AUDIT_LOG_ENABLED=true
PHI_ENCRYPTION_KEY=your_256_bit_key_here
