/backend/app/workers/               @parrish727
/backend/app/core/                  @parrish727
/backend/app/seeds/                 @parrish727

# ── Frontend domain — UI ────────────────────────────────────────────────────
/frontend/src/                      @parrish727

# ── Frontend + QA domain — automated E2E tests (Playwright) ─────────────────
/e2e/                               @parrish727

# ── Product/architecture docs & steering ────────────────────────────────────
/docs/                              @parrish727
